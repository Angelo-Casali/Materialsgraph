{
  "name": "materialsgraph-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Periodic Atlas: showcase website for the MaterialsGraph battery-materials knowledge graph",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-budget.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@preact/signals": "^2.0.0",
    "preact": "^10.26.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "^2.10.0",
    "@types/node": "^22.20.5",
    "ajv": "^8.17.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
