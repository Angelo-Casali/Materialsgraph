# Neo4j (local Docker Community edition)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Materials Project API
MP_API_KEY=

# LM Studio (local LLM, OpenAI-compatible endpoint) -- bulk extraction, router, synthesis
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen2.5-14b-instruct

# Local embeddings (384-dim; must match schema.cypher vector indexes)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Claude API (validation passes only: `mg harvest validate --cloud`)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Literature connectors (polite pools; all optional)
OPENALEX_MAILTO=
UNPAYWALL_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=

# --- Public query layer (deployed API only; extraction above always stays on LM Studio) ---
# Any OpenAI-compatible free tier, e.g. Groq (https://api.groq.com/openai/v1) or OpenRouter ":free" models.
QUERY_LLM_BASE_URL=
QUERY_LLM_API_KEY=
QUERY_LLM_MODEL=
QUERY_LLM_MAX_TOKENS=600
QUERY_LLM_TIMEOUT_S=20
# optional second provider used when the first is rate-limited
QUERY_LLM_FALLBACK_BASE_URL=
QUERY_LLM_FALLBACK_API_KEY=
QUERY_LLM_FALLBACK_MODEL=
# set to 1 to let `mg ask` fall back to LM Studio when no hosted query model is configured
QUERY_LLM_ALLOW_LOCAL=1

# sentence-transformers (local default) | fastembed (light) | none (public demo)
EMBEDDING_BACKEND=sentence-transformers

# --- API (api/mg_api) ---
PUBLIC_MODE=1
CORS_ORIGINS=https://angelo-casali.github.io,http://localhost:5173,http://localhost:4173
DAILY_LLM_BUDGET=800
# TURNSTILE_SECRET=   # optional free Cloudflare Turnstile bot check on /api/ask
